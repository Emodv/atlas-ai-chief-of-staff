# Web
NEXT_PUBLIC_ATLAS_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
CRON_SECRET=

# API
ATLAS_ENV=development
DATABASE_URL=postgresql://atlas:atlas@localhost:5432/atlas

# LLM provider (set in your own .env; never commit secrets)
OPENAI_API_KEY=

# OAuth / connectors
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=

# Autonomous provider execution.
# Atlas will only start a new provider side effect when BOTH executor and verifier
# are configured for that provider. The verifier must independently read the
# provider after the write and return { ok: true, verified: true, receipt, result }.
ATLAS_GMAIL_EXECUTOR_URL=
ATLAS_GMAIL_EXECUTOR_SECRET=
ATLAS_GMAIL_VERIFIER_URL=
ATLAS_GMAIL_VERIFIER_SECRET=

ATLAS_CALENDAR_EXECUTOR_URL=
ATLAS_CALENDAR_EXECUTOR_SECRET=
ATLAS_CALENDAR_VERIFIER_URL=
ATLAS_CALENDAR_VERIFIER_SECRET=

ATLAS_HUBSPOT_EXECUTOR_URL=
ATLAS_HUBSPOT_EXECUTOR_SECRET=
ATLAS_HUBSPOT_VERIFIER_URL=
ATLAS_HUBSPOT_VERIFIER_SECRET=

ATLAS_CONTACTS_EXECUTOR_URL=
ATLAS_CONTACTS_EXECUTOR_SECRET=
ATLAS_CONTACTS_VERIFIER_URL=
ATLAS_CONTACTS_VERIFIER_SECRET=

ATLAS_DRIVE_EXECUTOR_URL=
ATLAS_DRIVE_EXECUTOR_SECRET=
ATLAS_DRIVE_VERIFIER_URL=
ATLAS_DRIVE_VERIFIER_SECRET=

ATLAS_NOTION_EXECUTOR_URL=
ATLAS_NOTION_EXECUTOR_SECRET=
ATLAS_NOTION_VERIFIER_URL=
ATLAS_NOTION_VERIFIER_SECRET=

# Optional memory/vector services
VECTOR_DATABASE_URL=
